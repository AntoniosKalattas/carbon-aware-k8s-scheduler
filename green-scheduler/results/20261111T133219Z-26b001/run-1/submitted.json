{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "cpu-000",
        "namespace": "green-20261111t133219z-26b001-1"
      },
      "spec": {
        "backoffLimit": 0,
        "activeDeadlineSeconds": 60,
        "template": {
          "metadata": {
            "labels": {
              "app": "cpu-benchmark"
            }
          },
          "spec": {
            "restartPolicy": "Never",
            "schedulerName": "green-scheduler",
            "nodeSelector": {
              "benchmark": "true"
            },
            "containers": [
              {
                "name": "cpu",
                "image": "python:3.12.8-slim",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "/bench/cpu_benchmark.py",
                  "--limit",
                  "300000",
                  "--repeats",
                  "30",
                  "--input-region",
                  "italy"
                ],
                "resources": {
                  "requests": {
                    "cpu": "3",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "3",
                    "memory": "128Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "code",
                    "mountPath": "/bench",
                    "readOnly": true
                  }
                ],
                "env": [
                  {
                    "name": "BENCHMARK_NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  },
                  {
                    "name": "BENCHMARK_NODE_REGIONS",
                    "value": "{\"green-six-worker\": \"cyprus\", \"green-six-worker2\": \"greece\", \"green-six-worker3\": \"italy\", \"green-six-worker4\": \"cyprus\", \"green-six-worker5\": \"greece\", \"green-six-worker6\": \"italy\"}"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "code",
                "configMap": {
                  "name": "benchmark-code"
                }
              }
            ]
          }
        }
      }
    },
