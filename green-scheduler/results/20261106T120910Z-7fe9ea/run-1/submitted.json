{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "cpu-000",
        "namespace": "green-20261106t120910z-7fe9ea-1"
      },
      "spec": {
        "backoffLimit": 0,
        "activeDeadlineSeconds": 600,
        "template": {
          "metadata": {
            "labels": {
              "app": "cpu-benchmark"
            }
          },
          "spec": {
            "restartPolicy": "Never",
            "schedulerName": "default-scheduler",
            "nodeSelector": {
              "benchmark": "true"
            },
            "containers": [
              {
                "name": "cpu",
                "image": "python:3.12.8-slim",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "/bench/cpu_benchmark.py",
                  "--limit",
                  "10000",
                  "--repeats",
                  "1"
                ],
                "resources": {
                  "requests": {
                    "cpu": "1",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "128Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "code",
                    "mountPath": "/bench",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "code",
                "configMap": {
                  "name": "benchmark-code"
                }
              }
            ]
          }
        }
      }
    },
